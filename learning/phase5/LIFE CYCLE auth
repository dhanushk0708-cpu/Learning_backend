def require_role(required_role):

    def role_checker(
        user = Depends(get_current_user)
    ):

        if user.role != required_role:
            raise ForbiddenError(
                "You don't have permission",
                "INSUFFICIENT_ROLE"
            )

        return user

    return role_checker

                     
                     
